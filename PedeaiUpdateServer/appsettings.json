{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft": "Warning" } },
  "AllowedHosts": "*",

  // API Key usada pelos clientes (UpdateService). Configure também no appsettings do UpdateService.
  "ClienteApiKey": "PEDEAI-UPDATE-CLIENT-KEY-ALTERE",

  // Token usado pelo PedeaiUpdateAdmin (admin/publisher).
  "AdminToken": "PEDEAI-UPDATE-ADMIN-TOKEN-ALTERE",

  // Diretório onde o banco SQLite e os pacotes são armazenados no servidor.
  "DataDir": "Data",
  "PackagesDir": "Data/packages",

  "Urls": "http://0.0.0.0:5001"
}
