{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft": "Warning" } },
  "AllowedHosts": "*",

  // API Key usada pelos clientes (UpdateService). Configure também no appsettings do UpdateService.
  "ClienteApiKey": "PEDEAI-UPDATE-CLIENT-KEY-ALTERE",

  // Token usado pelo PedeaiUpdateAdmin (admin/publisher).
  "AdminToken": "PEDEAI-UPDATE-ADMIN-TOKEN-ALTERE",

  // String de conexão Supabase (PostgreSQL).
  // Formato: Host=xxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=SENHA;SslMode=Require;Trust Server Certificate=true
  "ConnectionStrings": {
    "Supabase": "Host=ALTERE.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=ALTERE;SslMode=Require;Trust Server Certificate=true"
  },

  // Diretório onde os pacotes ZIP ficam armazenados no servidor.
  "PackagesDir": "Data/packages",

  "Urls": "http://0.0.0.0:5001"
}
