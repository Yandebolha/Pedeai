<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net5.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Pedeai</AssemblyName>
    <RootNamespace>Pedeai</RootNamespace>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <SupportedOSPlatformVersion>6.1</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Metadados dos arquivos Designer para o VS exibir corretamente -->
  <ItemGroup>
    <Compile Update="Form1.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form1.Designer.cs">
      <DependentUpon>Form1.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\frmCadastroCategoria.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmCadastroCategoria.Designer.cs">
      <DependentUpon>frmCadastroCategoria.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\frmCadastroCliente.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmCadastroCliente.Designer.cs">
      <DependentUpon>frmCadastroCliente.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\frmCadastroCupom.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmCadastroCupom.Designer.cs">
      <DependentUpon>frmCadastroCupom.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\frmCadastroFornecedor.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmCadastroFornecedor.Designer.cs">
      <DependentUpon>frmCadastroFornecedor.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\frmCadastroProduto.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmCadastroProduto.Designer.cs">
      <DependentUpon>frmCadastroProduto.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\frmPedidoManual.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmPedidoManual.Designer.cs">
      <DependentUpon>frmPedidoManual.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\frmSelecionarCliente.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmSelecionarCliente.Designer.cs">
      <DependentUpon>frmSelecionarCliente.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Forms\frmCadastroProduto.resx">
      <DependentUpon>frmCadastroProduto.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>