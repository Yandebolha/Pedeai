<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ConfigBD</AssemblyName>
    <RootNamespace>ConfigBD</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
  </ItemGroup>

  <Target Name="CopyToRanGoFood" AfterTargets="Build">
    <PropertyGroup>
      <RanGoFoodBin>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Pedeai\bin\$(Configuration)\net5.0-windows\'))</RanGoFoodBin>
    </PropertyGroup>
    <MakeDir Directories="$(RanGoFoodBin)" />
    <Copy SourceFiles="$(TargetDir)ConfigBD.exe"
          DestinationFolder="$(RanGoFoodBin)"
          SkipUnchangedFiles="false"
          ContinueOnError="true" />
    <Message Text="ConfigBD.exe copiado para RanGoFood bin" Importance="high" />
  </Target>

</Project>
