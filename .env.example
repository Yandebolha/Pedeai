# ── Copie este arquivo para .env e preencha os valores ────────────────────────

# Chave de API para o servidor de licenças (configure também nos clientes: App.config → LicencaApiKey)
LICENCA_API_KEY=PEDEAI-LIC-API-KEY-ALTERE-AQUI

# Chave de API para os clientes do servidor de atualizações (configure em appsettings.json do UpdateService)
UPDATE_CLIENT_KEY=PEDEAI-UPDATE-CLIENT-KEY-ALTERE-AQUI

# Token do administrador para o PedeaiUpdateAdmin (configure no app admin)
UPDATE_ADMIN_TOKEN=PEDEAI-UPDATE-ADMIN-TOKEN-ALTERE-AQUI
